<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<AssignMessage continueOnError="false" enabled="true" name="AM-Extract-APIKey">
    <DisplayName>Extract API Key</DisplayName>
    <!-- Fallback to x-goog-api-key if present -->
    <Set>
        <Headers>
            <Header name="x-api-key">{request.header.x-goog-api-key}</Header>
        </Headers>
    </Set>
    <!-- Fallback to query param key if present -->
    <AssignVariable>
        <Name>request.header.x-api-key</Name>
        <Ref>request.queryparam.key</Ref>
    </AssignVariable>
    <!-- Fallback to query param apikey if present -->
    <AssignVariable>
        <Name>request.header.x-api-key</Name>
        <Ref>request.queryparam.apikey</Ref>
    </AssignVariable>
    <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
    <AssignTo createNew="false" transport="http" type="request"/>
</AssignMessage>
