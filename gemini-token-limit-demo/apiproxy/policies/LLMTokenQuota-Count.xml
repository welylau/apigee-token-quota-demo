<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<LLMTokenQuota continueOnError="false" enabled="true" name="LLMTokenQuota-Count" type="rollingwindow">
    <DisplayName>LLM Token Quota Count</DisplayName>
    <SharedName>gemini-token-quota</SharedName>
    <CountOnly>true</CountOnly>
    <LLMModelSource>gemini-3.5-flash-lite</LLMModelSource>
    <Identifier ref="verifyapikey.VerifyAPIKey.client_id"/>
    <UseQuotaConfigInAPIProduct stepName="VerifyAPIKey">
        <DefaultConfig>
            <Allow>4000</Allow>
            <Interval>5</Interval>
            <TimeUnit>minute</TimeUnit>
        </DefaultConfig>
    </UseQuotaConfigInAPIProduct>
    <Distributed>true</Distributed>
    <Synchronous>true</Synchronous>
    <LLMTokenUsageSource>{jsonPath('$.usageMetadata.totalTokenCount',response.content,true)}</LLMTokenUsageSource>
</LLMTokenQuota>
